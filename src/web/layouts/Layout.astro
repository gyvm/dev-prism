---
import { ClientRouter } from "astro:transitions";

import { siteBase } from "../base-path.ts";
import "../../ui/theme.css";

interface Props {
  title?: string;
}

const { title = "PR Analytics" } = Astro.props;
// The site root redirects to Explore — see pages/index.astro.
// Trailing slashes are required: a bare `/explore` collides with the sibling
// module src/web/explore.ts in dev (Vite serves it as JS); `/explore/` resolves
// to the page. Slashes are also the canonical directory-format URLs in prod.
const base = siteBase();
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    {/* Client-side navigation, so moving between Explore views swaps the body
        without tearing down the JS realm. That is what lets the module-scope
        DuckDB runner (duckdb-runner.ts) outlive the island remount and skip the
        multi-second WASM boot. */}
    <ClientRouter />
    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>
</html>
