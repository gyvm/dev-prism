---
import { getJsDelivrBundles } from "@duckdb/duckdb-wasm";

import Layout from "../../layouts/Layout.astro";
import Explore from "../../islands/Explore";
import { PAGE_STYLES } from "../../../renderers/page-styles.js";
import { EXPLORE_STYLES } from "../../shell/explore-styles.js";
import { VIEW_IDS, VIEWS, resolveViewId } from "../../views/registry.js";
import { siteBase } from "../../base-path.ts";

// One static page per Explore view (/explore/<view>/). Navigation between them
// goes through Astro's ClientRouter, which swaps the body without tearing down
// the JS realm — so the module-scope DuckDB runner survives and the multi-second
// WASM boot happens once per session, not once per view.
//
// Explore still injects PAGE_STYLES, and "one stylesheet per path" is NOT done.
// The React chart components reuse its class names (.timeline-row, .bg-node,
// .metric-card) by design, and those rules are interleaved with report-only
// chrome — `section`, `h2`, `.section-head` and `.empty` are used by both. A
// correct split is its own change, tracked in docs/explore-views-plan.md as
// deferred work, not something to eyeball mid-refactor.

export function getStaticPaths() {
  return VIEW_IDS.map((view) => ({ params: { view } }));
}

const view = resolveViewId(Astro.params.view);
const base = siteBase();

// Preload the DuckDB-WASM module so the multi-MB download starts during HTML
// parse instead of after the island's JS executes. getJsDelivrBundles() runs
// here at build time and derives the URL from the installed package version,
// so it always matches what selectBundle() resolves at runtime. The runtime
// picks eh vs mvp by feature detection; eh is what every current browser gets,
// the mvp fallback simply doesn't benefit from the hint.
// The wasm is consumed by the DuckDB worker, which can't read the document's
// preload cache — Chrome therefore logs "preloaded but not used". That warning
// is benign: the worker's fetch coalesces with the in-flight download via the
// HTTP cache, so the module still crosses the network exactly once.
const wasmModuleUrl = getJsDelivrBundles().eh.mainModule;
---

<Layout title={`${VIEWS[view].label} — Explore`} active="explore">
  <Fragment slot="head">
    <link rel="preload" as="fetch" crossorigin="anonymous" href={wasmModuleUrl} />
  </Fragment>
  {/* is:global is REQUIRED throughout: <Explore client:only="react"> renders
      the whole island in the browser, so Astro-scoped selectors (cid-attributed)
      never match its DOM. Without it these rules are dead code and the controls
      fall back to UA defaults — which Tailwind preflight then strips. */}
  <style is:global set:html={PAGE_STYLES}></style>
  <style is:global set:html={EXPLORE_STYLES}></style>

  <nav class="explore-tabs" aria-label="ビュー">
    {
      VIEW_IDS.map((id) => (
        <a
          class:list={["explore-tab", { "is-active": id === view }]}
          href={`${base}explore/${id}/`}
          data-view={id}
          aria-current={id === view ? "page" : undefined}
        >
          {VIEWS[id].label}
        </a>
      ))
    }
  </nav>

  <Explore client:only="react" view={view} />
</Layout>

<script>
  // Carry the active filter scope across view links. The hrefs are static (the
  // scope lives in the URL query, which only exists at runtime), so rewrite them
  // at click time. Capture phase, so this runs before ClientRouter handles the
  // navigation. Bound to `document`, which ClientRouter preserves — and bundled
  // module scripts execute once per session, so this never double-binds.
  document.addEventListener(
    "click",
    (event) => {
      const target = event.target as HTMLElement | null;
      const link = target?.closest?.("a[data-view]") as HTMLAnchorElement | null;
      if (link && window.location.search) {
        link.setAttribute("href", link.pathname + window.location.search);
      }
    },
    true,
  );
</script>
