{
  "name": "gh-insights",
  "version": "0.5.0",
  "description": "Dev Prism — an Explore dashboard for engineering reflection meetings.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && npm run typecheck:web",
    "test": "vitest run",
    "collect": "tsx src/cli/collect.ts",
    "dwh:build": "tsx src/cli/dwh-build.ts",
    "dwh:schema": "tsx src/cli/dwh-schema.ts",
    "explore:data": "tsx src/cli/explore-data.ts",
    "web:dev": "astro dev --root src/web",
    "web:build": "ASTRO_BASE=/dev-prism astro build --root src/web",
    "web:preview": "ASTRO_BASE=/dev-prism astro preview --root src/web",
    "web:check": "astro check --root src/web",
    "typecheck:web": "tsc -p src/web/tsconfig.json --noEmit",
    "storybook": "storybook dev -p 6006 --no-open",
    "storybook:build": "storybook build"
  },
  "dependencies": {
    "@duckdb/node-api": "^1.5.3-r.3",
    "@internationalized/date": "^3.12.2",
    "@octokit/auth-app": "^8.1.1",
    "@octokit/request": "^10.0.13",
    "react": "^19.2.7",
    "react-aria-components": "^1.19.0",
    "react-dom": "^19.2.7",
    "smol-toml": "^1.6.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/react": "^5.0.7",
    "@duckdb/duckdb-wasm": "^1.33.1-dev45.0",
    "@storybook/react-vite": "^10.5.3",
    "@tailwindcss/postcss": "^4.3.1",
    "@types/node": "^24.6.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "astro": "^6.4.8",
    "daisyui": "^5.5.23",
    "storybook": "^10.5.3",
    "tailwindcss": "^4.3.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "vite": "^7"
  }
}
